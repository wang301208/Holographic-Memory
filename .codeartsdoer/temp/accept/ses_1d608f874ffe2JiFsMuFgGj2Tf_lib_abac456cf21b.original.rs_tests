#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_holographic_memory_store() {
        let config = HolographicConfig::default();
        let mut hm = HolographicMemory::new(config);
        let data: Vec<f64> = (0..256).map(|i| (i as f64 * 0.02).sin()).collect();
        let result = hm.store(&data).unwrap();
        assert!(result.fragment_count > 0);
        assert!(result.total_fragments > 0);
        assert!(hm.fragment_count() > 0);
    }

    #[test]
    fn test_holographic_memory_retrieve() {
        let config = HolographicConfig {
            encoding: crate::foundation::config::EncodingConfig {
                fft_window_size: 256,
                overlap_ratio: 0.5,
                redundancy_level: 2,
                phase_modulation: false,
                normalize: true,
            },
            ..Default::default()
        };
        let mut hm = HolographicMemory::new(config);
        let data: Vec<f64> = (0..256).map(|i| (i as f64 * 0.02).sin()).collect();
        let store_result = hm.store(&data).unwrap();
        let decoded = hm.retrieve(store_result.source_hash, data.len()).unwrap();
        assert_eq!(decoded.len(), data.len());
    }

    #[test]
    fn test_holographic_memory_search() {
        let config = HolographicConfig {
            encoding: crate::foundation::config::EncodingConfig {
                fft_window_size: 256,
                overlap_ratio: 0.5,
                redundancy_level: 2,
                phase_modulation: false,
                normalize: true,
            },
            ..Default::default()
        };
        let mut hm = HolographicMemory::new(config);
        let data: Vec<f64> = (0..256).map(|i| (i as f64 * 0.02).sin()).collect();
        hm.store(&data).unwrap();
        let query: Vec<f64> = (0..256).map(|i| (i as f64 * 0.02).sin()).collect();
        let results = hm.search(&query, 5).unwrap();
        assert!(results.len() <= 5);
    }

    #[test]
    fn test_holographic_memory_integrity() {
        let config = HolographicConfig::default();
        let mut hm = HolographicMemory::new(config);
        let data: Vec<f64> = (0..256).map(|i| (i as f64 * 0.02).sin()).collect();
        let store_result = hm.store(&data).unwrap();
        let integrity = hm.integrity(store_result.source_hash);
        assert!(integrity.fragments_available > 0);
    }

    #[test]
    fn test_holographic_memory_with_persistence() {
        let dir = std::env::temp_dir().join("holographic_api_test");
        let _ = std::fs::remove_dir_all(&dir);
        let config = HolographicConfig::default();
        let mut hm = HolographicMemory::new(config).with_persistence(&dir);
        let data: Vec<f64> = (0..128).map(|i| (i as f64 * 0.05).sin()).collect();
        let result = hm.store(&data).unwrap();
        assert!(result.fragment_count > 0);

        hm.save().unwrap();

        let mut hm2 = HolographicMemory::new(HolographicConfig::default()).with_persistence(&dir);
        hm2.load().unwrap();
        assert!(hm2.fragment_count() > 0);
    }

    #[test]
    fn test_holographic_memory_fault_tolerance() {
        let config = HolographicConfig {
            encoding: crate::foundation::config::EncodingConfig {
                fft_window_size: 256,
                overlap_ratio: 0.5,
                redundancy_level: 3,
                phase_modulation: false,
                normalize: true,
            },
            ..Default::default()
        };
        let mut hm = HolographicMemory::new(config);
        let data: Vec<f64> = (0..512).map(|i| (i as f64 * 0.02).sin()).collect();

        let result = hm.store_with_fault_tolerance(&data, 0.3).unwrap();
        assert!(result.total_fragments > 0);
        assert!(result.available_fragments > 0);
        assert!(result.integrity.damage_ratio <= 1.0);
    }

    #[test]
    fn test_holo_error_display() {
        let err = HoloError::Encode("测试错误".to_string());
        assert!(err.to_string().contains("测试错误"));
    }

    #[test]
    fn test_phase_key_thread_safety() {
        use std::sync::Arc;
        use std::thread;

        let keys: Arc<std::sync::Mutex<Vec<PhaseKey>>> = Arc::new(std::sync::Mutex::new(Vec::new()));
        let mut handles = Vec::new();

        for _ in 0..4 {
            let keys = Arc::clone(&keys);
            handles.push(thread::spawn(move || {
                let pk = PhaseKey::random(10);
                keys.lock().unwrap().push(pk);
            }));
        }

        for h in handles {
            h.join().unwrap();
        }

        let keys = keys.lock().unwrap();
        assert_eq!(keys.len(), 4);
        for key in keys.iter() {
            assert_eq!(key.dimension, 10);
        }
    }

    #[test]
    fn test_config_load_from_str() {
        let toml = r#"
[encoding]
fft_window_size = 512
overlap_ratio = 0.25
redundancy_level = 2
phase_modulation = false
normalize = true

[storage]
data_dir = "./test_data"
max_segment_size = 33554432
auto_compact = true
sync_on_write = false

[retrieval]
top_k = 5
similarity_threshold = 0.5
max_association_hops = 2
enable_partial_recovery = false
"#;
        let config = HolographicConfig::load_from_str(toml).unwrap();
        assert_eq!(config.encoding.fft_window_size, 512);
        assert_eq!(config.retrieval.top_k, 5);
    }
}
